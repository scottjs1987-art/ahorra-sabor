# Supabase (anon key — segura para exponer en el cliente)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5...

# Cloudflare Worker
EXPO_PUBLIC_WORKER_URL=https://ahorra-sabor-worker.tu-subdominio.workers.dev

# Deep link scheme (debe coincidir con app.json > expo.scheme)
EXPO_PUBLIC_APP_SCHEME=ahorrasabor
